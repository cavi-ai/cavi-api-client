{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {}
  },
  "include": ["docs/**/*.ts", "docs/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
