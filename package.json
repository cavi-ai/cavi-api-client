{
  "name": "@cavi-ai/api-client",
  "version": "0.10.1",
  "description": "Provider-agnostic TypeScript client for AI agent runtimes — one RuntimeClient contract spanning Claude (incl. Claude Managed Agents, beta), Codex via OpenAI Responses, Gemini, Hermes, and OpenClaw, with HTTP + WebSocket RPC, SSE, manifest-driven routing, and graceful degradation. ESM, zero runtime deps, optional React bindings.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "sideEffects": false,
  "license": "MIT",
  "author": "CAVI AI",
  "homepage": "https://github.com/cavi-ai/cavi-api-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cavi-ai/cavi-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/cavi-ai/cavi-api-client/issues"
  },
  "keywords": [
    "api-client",
    "provider-agnostic",
    "runtime",
    "gateway",
    "websocket",
    "rpc",
    "sse",
    "typescript",
    "esm",
    "agent",
    "agents",
    "llm",
    "anthropic",
    "claude",
    "managed-agents",
    "claude-managed-agents",
    "stateful-agents",
    "openai",
    "codex",
    "responses",
    "gemini",
    "google",
    "mcp",
    "hermes",
    "openclaw",
    "fetch",
    "react",
    "cavi"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "CONTRIBUTORS.md",
    "SECURITY.md",
    "MIGRATION.md",
    "docs",
    "!docs/superpowers",
    "!docs/superpowers/**",
    "!docs/.DS_Store",
    "!docs/.code-review-graph",
    "!docs/.code-review-graph/**",
    "!docs/api",
    "!docs/api/**",
    "!docs/postman",
    "!docs/postman/**",
    "dist",
    "!dist/test-support",
    "!dist/__tests__",
    "src",
    "!src/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core/http": {
      "types": "./dist/core/http/index.d.ts",
      "import": "./dist/core/http/index.js",
      "default": "./dist/core/http/index.js"
    },
    "./core/data": {
      "types": "./dist/core/data/index.d.ts",
      "import": "./dist/core/data/index.js",
      "default": "./dist/core/data/index.js"
    },
    "./core/errors": {
      "types": "./dist/core/errors.d.ts",
      "import": "./dist/core/errors.js",
      "default": "./dist/core/errors.js"
    },
    "./core/memory": {
      "types": "./dist/core/memory/index.d.ts",
      "import": "./dist/core/memory/index.js",
      "default": "./dist/core/memory/index.js"
    },
    "./core/runtime": {
      "types": "./dist/core/runtime/index.d.ts",
      "import": "./dist/core/runtime/index.js",
      "default": "./dist/core/runtime/index.js"
    },
    "./core/runtime/providers": {
      "types": "./dist/core/runtime/providers/index.d.ts",
      "import": "./dist/core/runtime/providers/index.js",
      "default": "./dist/core/runtime/providers/index.js"
    },
    "./core/sse": {
      "types": "./dist/core/sse/index.d.ts",
      "import": "./dist/core/sse/index.js",
      "default": "./dist/core/sse/index.js"
    },
    "./core/ws": {
      "types": "./dist/core/ws/index.d.ts",
      "import": "./dist/core/ws/index.js",
      "default": "./dist/core/ws/index.js"
    },
    "./core/gateway": {
      "types": "./dist/core/gateway/index.d.ts",
      "import": "./dist/core/gateway/index.js",
      "default": "./dist/core/gateway/index.js"
    },
    "./core/env": {
      "types": "./dist/core/env/index.d.ts",
      "import": "./dist/core/env/index.js",
      "default": "./dist/core/env/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    },
    "./extensions/cavi": {
      "types": "./dist/extensions/cavi/index.d.ts",
      "import": "./dist/extensions/cavi/index.js",
      "default": "./dist/extensions/cavi/index.js"
    },
    "./extensions/cavi/library-clip-contract.json": "./src/extensions/cavi/library/clip-contract.json",
    "./providers/hermes": {
      "types": "./dist/providers/hermes/index.d.ts",
      "import": "./dist/providers/hermes/index.js",
      "default": "./dist/providers/hermes/index.js"
    },
    "./providers/openclaw": {
      "types": "./dist/providers/openclaw/index.d.ts",
      "import": "./dist/providers/openclaw/index.js",
      "default": "./dist/providers/openclaw/index.js"
    },
    "./providers/claude": {
      "types": "./dist/providers/claude/index.d.ts",
      "import": "./dist/providers/claude/index.js",
      "default": "./dist/providers/claude/index.js"
    },
    "./providers/codex": {
      "types": "./dist/providers/codex/index.d.ts",
      "import": "./dist/providers/codex/index.js",
      "default": "./dist/providers/codex/index.js"
    },
    "./providers/gemini": {
      "types": "./dist/providers/gemini/index.d.ts",
      "import": "./dist/providers/gemini/index.js",
      "default": "./dist/providers/gemini/index.js"
    },
    "./frameworks/react": {
      "types": "./dist/frameworks/react/index.d.ts",
      "import": "./dist/frameworks/react/index.js",
      "default": "./dist/frameworks/react/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify",
    "prepare": "husky",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint:md": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "typecheck:gate": "tsc --noEmit -p tsconfig.gate.json",
    "typecheck:docs": "tsc --noEmit -p tsconfig.docs.json",
    "diagnose": "node scripts/diagnose.mjs",
    "diagnose:static": "node scripts/diagnose.mjs --mode=static",
    "verify": "pnpm test && pnpm run typecheck:docs && pnpm run build && pnpm run lint:md && HUSKY=0 pnpm pack --dry-run",
    "release:dry": "pnpm run verify && HUSKY=0 pnpm publish --access public --no-git-checks --dry-run",
    "release": "pnpm publish --access public"
  },
  "pnpm": {
    "overrides": {
      "undici": "7.28.0"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.23.0",
    "react": "^19.2.6",
    "react-dom": "19.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
