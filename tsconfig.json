{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/index.ts",
    "src/core/**/*.ts",
    "src/contracts/**/*.ts",
    "src/cavi/**/*.ts",
    "src/providers/**/*.ts",
    "src/react/**/*.ts",
    "src/react/**/*.tsx",
    "src/compat/martina/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "quarantine/**"
  ]
}
