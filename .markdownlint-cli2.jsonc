{
  "globs": [
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "CONTRIBUTORS.md",
    "docs/**/*.md",
    "src/**/README.md",
    ".github/**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    ".pnpm-store/**",
    "dist/**",
    "quarantine/**",
    ".quarantine/**",
    ".claude/**",
    ".gemini/**",
    ".kiro/**",
    ".cursor/**",
    ".qoder/**",
    ".code-review-graph/**",
    ".remember/**",
    "docs/api/**",
    "docs/superpowers/**",
    ".superpowers/**"
  ]
}
